{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/decengine/model-profile.schema.json",
  "title": "decengine model profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "family",
    "architecture",
    "pooling",
    "normalize",
    "padding_side",
    "query_template",
    "candidate_template",
    "temperature",
    "max_length",
    "profile_version",
    "required_files"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "family": {"const": "qwen3-0.6b"},
    "architecture": {"enum": ["Qwen3ForCausalLM", "Qwen3Model"]},
    "pooling": {"const": "last_token"},
    "normalize": {"const": "l2"},
    "padding_side": {"const": "left"},
    "query_template": {"type": "string", "minLength": 1},
    "candidate_template": {"type": "string", "minLength": 1},
    "temperature": {"type": "number", "exclusiveMinimum": 0},
    "max_length": {"type": "integer", "minimum": 1},
    "profile_version": {"type": "string", "minLength": 1},
    "required_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
